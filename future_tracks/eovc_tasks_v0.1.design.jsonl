{"task_id": "X01", "scenario": "flood detected by one sensor, obscured for another", "question": "Node B (optical) reports no water on the AOI on 2026-10-20. Was the AOI flooded?", "units": [{"unit_id": "U-X01-SAR", "version": {"number": 1, "status": "CURRENT", "supersedes": null}, "knowledge_at": "2026-11-01", "asset_reference": {"id": "AOI-EOVC-1", "type": "area of interest", "area_ha": 1200.0}, "claim": {"type": "surface_water_extent", "statement": "Open surface water within the AOI", "interval": "2026-10-20/2026-10-20", "scope": "whole AOI"}, "assessment": {"status": "SUPPORTED", "reasons": []}, "observations": [{"source": "Sentinel-1 GRD", "observed": "water 140 ha"}], "observability": {"cloud_independent": true, "valid_fraction": 0.97}, "supports": ["open water present on 140 ha"], "does_not_establish": [{"code": "cause_not_established", "text": "the cause of the inundation"}, {"code": "damage_not_established", "text": "damage to crops, buildings or people"}, {"code": "absence_not_established", "text": "that areas not observed were dry"}], "source_lineage": [{"provider": "ESA/Copernicus", "dataset": "Sentinel-1 GRD", "version": "IPF 3.9"}], "processing_lineage": {"engine": "sar-water", "version": "1"}}, {"unit_id": "U-X01-OPT", "version": {"number": 1, "status": "CURRENT", "supersedes": null}, "knowledge_at": "2026-11-01", "asset_reference": {"id": "AOI-EOVC-1", "type": "area of interest", "area_ha": 1200.0}, "claim": {"type": "surface_water_extent", "statement": "Open surface water within the AOI", "interval": "2026-10-20/2026-10-20", "scope": "whole AOI"}, "assessment": {"status": "INSUFFICIENT_EVIDENCE", "reasons": ["unobservable"]}, "observations": [{"source": "Sentinel-2 L2A", "observed": "cloud 92%"}], "observability": {"cloud_fraction": 0.92, "valid_fraction": 0.08}, "supports": [], "does_not_establish": [{"code": "cause_not_established", "text": "the cause of the inundation"}, {"code": "damage_not_established", "text": "damage to crops, buildings or people"}, {"code": "absence_not_established", "text": "that areas not observed were dry"}], "source_lineage": [{"provider": "ESA/Copernicus", "dataset": "Sentinel-2 L2A", "version": "05.11"}], "processing_lineage": {"engine": "optical-water", "version": "1"}}], "expected_safe_conclusion": "SAR supports open water on 140 ha; the optical node could not observe (92% cloud), so its 'no water' is not evidence of absence.", "forbidden_families": ["absence_from_unobservable", "disagreement_invented"]}
