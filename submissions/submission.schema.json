            }
           }
          }
         }
        },
        "ucr_by_category": {
         "type": "object"
        },
        "judge_agreement_kappa_uc": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     ]
    }
   }
  },
  "declarations": {
   "type": "object",
   "required": [
    "contamination",
    "tuned_on_tegb",
    "rights_to_share_outputs"
   ],
   "properties": {
    "contamination": {
     "enum": [
      "no-known-exposure",
      "possible-exposure",
      "known-exposure",
      "unknown"
     ]
    },
    "contamination_notes": {
     "type": [
      "string",
      "null"
     ]
    },
    "tuned_on_tegb": {
     "type": "boolean"
    },
    "rights_to_share_outputs": {
     "const": true
    },
    "outputs_are_ai_generated": {
     "const": true
    }
   }
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  },
  "reference_evaluation": {
   "type": "object",
   "required": [
    "evaluated_by",
    "date"
   ],
   "description": "Present when judgments.jsonl is included: who ran the two reference judges.",
   "properties": {
    "evaluated_by": {
     "type": "string",
     "minLength": 1,
     "description": "'submitter', or the maintainers when the evaluation was run for the submitter (for example under the TEGB Early Evaluation Program)."
    },
    "date": {
     "type": "string"
    }
   }
  }
 }
}
