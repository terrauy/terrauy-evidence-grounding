{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/terrauy/terrauy-evidence-grounding/submissions/submission.schema.json",
 "title": "TEGB submission (tegb-submission/1)",
 "description": "Written by `python -m tegb submit`. Do not edit by hand: the validator recomputes hashes and metrics.",
 "type": "object",
 "required": [
  "schema",
  "benchmark_version",
  "submission_id",
  "date",
  "model",
  "submitter",
  "protocol",
  "run",
  "hashes",
  "metrics",
  "declarations"
 ],
 "properties": {
  "schema": {
   "const": "tegb-submission/1"
  },
  "benchmark_version": {
   "const": "v0.1",
   "description": "Scores of different benchmark versions are never mixed."
  },
  "submission_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$",
   "description": "Equal to the folder name."
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "model": {
   "type": "object",
   "required": [
    "name",
    "version",
    "provider"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "version": {
     "type": "string",
     "minLength": 1,
     "description": "Exact version, checkpoint or revision."
    },
    "provider": {
     "type": "string",
     "minLength": 1
    },
    "url": {
     "type": [
      "string",
      "null"
     ]
    },
    "ids_returned": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Model ids returned by the API during the run."
    },
    "weights": {
     "enum": [
      "open",
      "closed",
      "unknown"
     ]
    },
    "training_cutoff": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "submitter": {
   "type": "object",
   "required": [
    "name"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "contact": {
     "type": [
      "string",
      "null"
     ],
     "description": "Public contact only, for example a GitHub handle."
    },
    "affiliation": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "protocol": {
   "type": "object",
   "required": [
    "runs",
    "temperatures_by_run",
    "max_tokens",
    "deviations"
   ],
   "properties": {
    "runs": {
     "type": "integer"
    },
    "temperatures_by_run": {
     "type": "object"
    },
    "max_tokens": {
     "type": "array"
    },
    "prompt_source": {
     "type": "string"
    },
    "system_prompt": {
     "type": "string"
    },
    "deviations": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Empty for the standard protocol: 600 output tokens; temperature 0, 0.7, 0.7."
    }
   }
  },
  "run": {
   "type": "object",
   "required": [
    "adapter",
    "tools_version"
   ],
   "properties": {
    "adapter": {
     "type": "string"
    },
    "tools_version": {
     "type": "string"
    },
    "started_at": {
     "type": [
      "string",
      "null"
     ]
    },
    "finished_at": {
     "type": [
      "string",
      "null"
     ]
    },
    "python": {
     "type": [
      "string",
      "null"
     ]
    },
    "decoding_notes": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "hashes": {
   "type": "object",
   "required": [
    "tasks_file_sha256",
    "prompt_files_sha256",
    "responses_sha256"
   ],
   "properties": {
    "tasks_file_sha256": {
     "type": "string"
    },
    "prompt_files_sha256": {
     "type": "object"
    },
    "responses_sha256": {
     "type": "string"
    },
    "judgments_sha256": {
     "type": "string"
    }
   }
  },
  "stats": {
   "type": "object"
  },
  "metrics": {
   "type": "object",
   "required": [
    "core",
    "reference"
   ],
   "properties": {
    "core": {
     "type": "object",
     "required": [
      "by_condition",
      "ucr_by_category",
      "instrument"
     ],
     "properties": {
      "instrument": {
       "type": "string"
      },
      "by_condition": {
       "type": "object",
       "required": [
        "RAW",
        "TEXT",
        "STRUCTURED"
       ],
       "properties": {
        "RAW": {
         "type": "object",
         "required": [
          "n",
          "ucr",
          "constraint_violations",
          "scope_errors"
         ],
         "properties": {
          "n": {
           "type": "integer"
          },
          "ucr": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "constraint_violations": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "observability_errors": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "scope_errors": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "factual_accuracy": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "source_attribution_accuracy": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "version_compliance": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "appropriate_abstention": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          }
         }
        },
        "TEXT": {
         "type": "object",
         "required": [
          "n",
          "ucr",
          "constraint_violations",
          "scope_errors"
         ],
         "properties": {
          "n": {
           "type": "integer"
          },
          "ucr": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "constraint_violations": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "observability_errors": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "scope_errors": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "factual_accuracy": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "source_attribution_accuracy": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "version_compliance": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "appropriate_abstention": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          }
         }
        },
        "STRUCTURED": {
         "type": "object",
         "required": [
          "n",
          "ucr",
          "constraint_violations",
          "scope_errors"
         ],
         "properties": {
          "n": {
           "type": "integer"
          },
          "ucr": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "constraint_violations": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "observability_errors": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "scope_errors": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "factual_accuracy": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "source_attribution_accuracy": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "version_compliance": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          },
          "appropriate_abstention": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 1
          }
         }
        }
       }
      },
      "ucr_by_category": {
       "type": "object"
      },
      "judge_agreement_kappa_uc": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    },
    "reference": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "by_condition",
        "ucr_by_category",
        "instrument"
       ],
       "properties": {
        "instrument": {
         "type": "string"
        },
        "by_condition": {
         "type": "object",
         "required": [
          "RAW",
          "TEXT",
          "STRUCTURED"
         ],
         "properties": {
          "RAW": {
           "type": "object",
           "required": [
            "n",
            "ucr",
            "constraint_violations",
            "scope_errors"
           ],
           "properties": {
            "n": {
             "type": "integer"
            },
            "ucr": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "constraint_violations": {
             "type": [
              "number",
