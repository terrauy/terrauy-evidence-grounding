            },
            "observability_errors": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "scope_errors": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "factual_accuracy": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "source_attribution_accuracy": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "version_compliance": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "appropriate_abstention": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            }
           }
          },
          "TEXT": {
           "type": "object",
           "required": [
            "n",
            "ucr",
            "constraint_violations",
            "scope_errors"
           ],
           "properties": {
            "n": {
             "type": "integer"
            },
            "ucr": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "constraint_violations": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "observability_errors": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "scope_errors": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "factual_accuracy": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "source_attribution_accuracy": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "version_compliance": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "appropriate_abstention": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            }
           }
          },
          "STRUCTURED": {
           "type": "object",
           "required": [
            "n",
            "ucr",
            "constraint_violations",
            "scope_errors"
           ],
           "properties": {
            "n": {
             "type": "integer"
            },
            "ucr": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "constraint_violations": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "observability_errors": {
             "type": [
              "number",
              "null"
             ],
             "minimum": 0,
             "maximum": 1
            },
            "scope_errors": {
             "type": [
              "number",
